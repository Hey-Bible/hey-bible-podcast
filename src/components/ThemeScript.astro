---
// Inline pre-paint script that resolves theme before first render to avoid FOUC.
// Mirrors heybible.org's 3-mode (light / dark / system) pattern.
---
<script is:inline>
  (function () {
    const theme = localStorage.getItem('theme') || 'system';
    const resolved =
      theme === 'system'
        ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
        : theme;
    document.documentElement.setAttribute('data-theme', resolved);
  })();
</script>
