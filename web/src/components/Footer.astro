---
const year = new Date().getFullYear();
---
<footer
  class="border-t py-6 mt-12"
  style="background-color: var(--color-retro-surface-bar); border-color: var(--color-retro-secondary);"
>
  <nav class="flex flex-col items-center gap-4 px-4 max-w-[1200px] mx-auto">
    <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-2">
      <a href="/" class="text-sm font-semibold no-underline glow-hover" style="color: var(--color-retro-text);">Home</a>
      <a href="/books/" class="text-sm font-semibold no-underline glow-hover" style="color: var(--color-retro-text);">Books</a>
      <a href="/feed.xml" class="text-sm font-semibold no-underline glow-hover" style="color: var(--color-retro-text);">RSS</a>
      <a href="https://github.com/Hey-Bible/hey-bible-podcast" class="text-sm font-semibold no-underline glow-hover" style="color: var(--color-retro-text);" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="https://heybible.org" class="text-sm font-semibold no-underline glow-hover" style="color: var(--color-retro-text);" target="_blank" rel="noopener noreferrer">Hey Bible</a>
    </div>
    <p class="text-xs opacity-70" style="color: var(--color-retro-text);">
      ✝️.fm · Hey Bible Podcast · &copy; {year} Working Dev's Hero
    </p>
  </nav>
</footer>
