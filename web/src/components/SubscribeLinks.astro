---
import subscribe from '~/data/subscribe.json';

const links = [
  { href: subscribe.apple, label: 'Apple Podcasts', icon: '' },
  { href: subscribe.spotify, label: 'Spotify', icon: '' },
  { href: subscribe.overcast, label: 'Overcast', icon: '' },
  { href: subscribe.rss, label: 'RSS', icon: '' },
];
---
<section class="text-center py-6">
  <h2 class="text-2xl font-extrabold mb-4">Subscribe</h2>
  <p class="opacity-80 mb-6 max-w-[600px] mx-auto">
    Listen on your favorite podcast app. New book every month.
  </p>
  <div class="flex flex-wrap items-center justify-center gap-3">
    {links.map(({ href, label }) => (
      <a
        href={href}
        class="cta-button"
        target={href.startsWith('http') ? '_blank' : undefined}
        rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
      >
        {label}
      </a>
    ))}
  </div>
  <p class="text-sm opacity-70 mt-4">
    Search verses, save favorites, and create beautiful verse art with the free <a href="https://heybible.org" target="_blank" rel="noopener noreferrer" class="underline">Hey Bible</a> app.
  </p>
</section>
